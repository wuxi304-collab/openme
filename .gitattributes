# Normalize text files to LF in the repository to keep diffs minimal on Windows.
# Without this, editors/tooling that write CRLF rewrite whole files and produce
# thousands of lines of noise per logical change.
* text=auto eol=lf

# Windows batch launchers must keep CRLF: cmd.exe misbehaves with LF-only .cmd files.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never normalize, never diff as text.
*.png binary
*.ico binary
*.icns binary
*.svg text eol=lf
*.dwg binary
*.dxf binary
*.dll binary
*.exe binary
*.ttf binary
*.otf binary
